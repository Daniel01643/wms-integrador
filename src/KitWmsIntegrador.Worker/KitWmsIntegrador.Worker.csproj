<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-KitWmsIntegrador.Worker-19cf5f2f-025b-46d9-9806-c8cedd063c07</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel da tela de devolução (Plano B fase 2). Vem do shared framework do SDK, sem pacote
         NuGet novo; o publish self-contained inclui o ASP.NET Core automaticamente. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Página única e logo embutidas no assembly: nenhum arquivo solto no publish. -->
    <EmbeddedResource Include="TelaDevolucao\PaginaDevolucao.html" LogicalName="PaginaDevolucao.html" />
    <EmbeddedResource Include="TelaDevolucao\logo-friozem.b64.txt" LogicalName="logo-friozem.b64.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KitWmsIntegrador.Core\KitWmsIntegrador.Core.csproj" />
  </ItemGroup>
</Project>
